# ───────── 必填 ─────────

# 大模型（OpenAI 兼容协议，默认 DeepSeek）：生成与自审结构化行程。
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Google Maps Platform（服务端）：Places (New)、Geocoding、Routes。
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ───────── 生产环境建议 ─────────

# 浏览器端 Key（Maps JavaScript API），应单独创建并限制 HTTP Referrer。
# 不填时回退为 GOOGLE_MAPS_API_KEY（仅建议本地开发这样用）。
# GOOGLE_MAPS_BROWSER_KEY=
# Advanced Markers 需要 Map ID；DEMO_MAP_ID 仅供开发测试。
# GOOGLE_MAP_ID=DEMO_MAP_ID

# NODE_ENV=production
# 允许跨域访问 API 的来源（逗号分隔）。生产环境默认只允许同源。
# ALLOWED_ORIGINS=https://example.com
# 部署在负载均衡 / 反向代理之后时设置，使限流按真实客户端 IP 统计。
# TRUST_PROXY=1

# ───────── 可选调优（括号内为默认值）─────────

PORT=3001
# LLM_TIMEOUT_MS=240000         # 单次大模型调用总时长上限
# LLM_IDLE_TIMEOUT_MS=90000     # 流式输出多久没有数据视为卡死并重试
# LLM_MAX_RETRIES=2             # 429/5xx/网络错误的重试次数
# LLM_STREAM=true               # 是否使用流式调用
# GOOGLE_TIMEOUT_MS=15000
# GOOGLE_MAX_CONCURRENCY=8      # Google API 全局并发上限
# GOOGLE_CACHE_TTL_MS=43200000  # 地理数据缓存 12 小时（条款上限 30 天）
# MAX_QUERY_LENGTH=1000
# MAX_TRIP_DAYS=30
# PLAN_TIMEOUT_MS=480000        # 单次规划总时长上限
# PLAN_MAX_CONCURRENT=8         # 同时进行的规划数
# PLAN_RATE_LIMIT=20            # 每个 IP 每个窗口内的规划次数（0 关闭）
# PLAN_RATE_WINDOW_MS=600000
# LOG_LEVEL=info                # debug | info | warn | error | silent
