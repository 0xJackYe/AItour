# DeepSeek: generates and reviews structured travel plans.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Google Maps Platform: Maps JavaScript, Places, Geocoding and Routes.
# For local development one key can be used by both client and server.
# For production, use separate browser/server keys with appropriate restrictions.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Express server
PORT=3001
