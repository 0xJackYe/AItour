# DeepSeek: generates and reviews structured travel plans.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Google Maps Platform server key: Places, Geocoding and Routes.
# Restrict this key by server IP and API scope. It is never bundled intentionally.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Browser-only Maps JavaScript key. Restrict it by HTTP referrer and Maps JS API.
VITE_GOOGLE_MAPS_API_KEY=your_browser_google_maps_api_key
# Optional production Map ID; local development can use DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=

# Optional Cloudflare deployment fallback when DeepSeek is unavailable.
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Cloudflare Workers production secrets are configured with Wrangler, never committed:
# npx wrangler secret put DEEPSEEK_API_KEY
# npx wrangler secret put GOOGLE_MAPS_API_KEY

# Express server
PORT=3001
# Production browser origins, comma-separated. Localhost is allowed only outside production.
CORS_ORIGINS=https://your-app.example.com
# Expensive planning endpoint limit per client IP.
PLAN_RATE_LIMIT_MAX=10
PLAN_RATE_LIMIT_WINDOW_MS=900000
# Set to 1 only behind a trusted single reverse proxy.
TRUST_PROXY=0
