{
  "name": "aitour",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test && npm --prefix client test",
    "check": "npm test && npm run build",
    "test:e2e": "node e2e/smoke.mjs",
    "cloudflare:dev": "npm run build && wrangler dev",
    "cloudflare:deploy": "npm run check && wrangler deploy",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "eval": "node eval/run.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.65.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
